<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>KUDUTEXT</AssemblyName>
    <RootNamespace>Kudutext</RootNamespace>
    <ApplicationIcon>Assets\KUDUTEXT.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <StartupObject>Kudutext.Program</StartupObject>

    <Version>0.3.0</Version>
    <Product>KUDUTEXT</Product>
    <Company>Azeem Bukhari</Company>
    <Authors>Azeem Bukhari</Authors>
    <Copyright>Copyright © 2026 Azeem Bukhari</Copyright>
    <Description>KUDUTEXT - speech to text and subtitles, on your PC</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--
    The screens are built in C# and the themes are XAML files loaded at startup, so the project
    needs no XAML compiler and builds with the plain .NET SDK on any operating system.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Reading sound from videos and recordings, through Windows' Media Foundation (MIT). -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Themes\*.xaml" LogicalName="Kudutext.Themes.%(Filename).xaml" />
    <EmbeddedResource Include="Assets\KUDUTEXT.ico" LogicalName="Kudutext.Assets.KUDUTEXT.ico" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
